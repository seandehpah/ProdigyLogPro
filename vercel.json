{
  "buildCommand": "echo 'Building...'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/index\\.html$",
      "dest": "/"
    },
    {
      "src": "/(.+)\\.html$",
      "dest": "/$1/"
    },
    {
      "src": "/(.*)/$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(.+)$",
      "dest": "/$1.html"
    }
  ]
}