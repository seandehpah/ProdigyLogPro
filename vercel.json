{
  "buildCommand": "echo 'Building...'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "/components/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.+)\\.html$",
      "dest": "/$1/"
    },
    {
      "src": "/(.*)/$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(.+)$",
      "dest": "/$1.html"
    },
    {
      "src": "/(.+\\..+)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}